# Makefile generated by VCS to build rmapats.so for your model
VSRC=/nfs/home/yanglucheng/workspace/test/AxiInfra/ut/AxiReorder

# Override TARGET_ARCH
TARGET_ARCH=

# Select your favorite compiler

# Linux:
# Compiler: 
VCS_CC=/usr/bin/gcc
# Internal CC for gen_c flow:
CC_CG=gcc

# Loader
LD=/usr/bin/g++
# Loader Flags
LDFLAGS=

# Default defines
SHELL=/bin/sh

VCSTMPSPECARG=
VCSTMPSPECENV=
# NOTE: if you have little space in $TMPDIR, but plenty in /foo,
#and you are using gcc, uncomment the next line
#VCSTMPSPECENV=SNPS_VCS_TMPDIR=/foo

TMPSPECARG=$(VCSTMPSPECARG)
TMPSPECENV=$(VCSTMPSPECENV)
CC=$(TMPSPECENV) $(VCS_CC) $(TMPSPECARG)

# C flags for compilation
CFLAGS=$(STDLIB)-w  -pipe -fPIC -Ofast -march=native -loop-unroll -I/nfs/home/yanglucheng/tools/verilua/v3.4.0/luajit-pro/luajit2.1/include -I/nfs/home/yanglucheng/tools/verilua/v3.4.0/luajit-pro/luajit2.1/include/luajit-2.1 -I/nfs/home/yanglucheng/tools/verilua/v3.4.0/src/include -I/nfs/home/yanglucheng/tools/verilua/v3.4.0/conan_installed/include -O -I/nfs/tools/synopsys/vcs/U-2023.03/include    

CFLAGS_CG=-w  -pipe -fPIC -I/nfs/tools/synopsys/vcs/U-2023.03/include -O  -fno-strict-aliasing -fno-optimize-sibling-calls   

CFLAGS_CG_CLIB=-w  -pipe -fPIC -I/nfs/tools/synopsys/vcs/U-2023.03/include -O  -fno-strict-aliasing -fno-optimize-sibling-calls   

CFLAGS_RMAR=-w  -pipe -fPIC -I/nfs/tools/synopsys/vcs/U-2023.03/include -O  -fno-strict-aliasing -fno-optimize-sibling-calls   

ASFLAGS=(null)
LIBS=

include filelist.hsopt


rmapats.so: $(HSOPT_OBJS)
	@$(VCS_CC) $(LDFLAGS) $(LIBS) -shared -o ./simv.daidir/rmapats.so $(HSOPT_OBJS)
